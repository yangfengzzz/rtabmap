Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3
      Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Global Points
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Color Transformer: AxisColor
      Axis: Z
      Channel Name: intensity
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_points
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Tomogram
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.1
      Color Transformer: Intensity
      Channel Name: intensity
      Min Intensity: -20
      Max Intensity: 60
      Invert Rainbow: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /tomogram
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Layer G 0
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.1
      Color Transformer: Intensity
      Channel Name: intensity
      Min Intensity: -20
      Max Intensity: 60
      Invert Rainbow: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /layer_G_0
      Use Fixed Frame: true
      Value: false
    - Alpha: 0.5
      Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Layer C 0
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.1
      Color Transformer: FlatColor
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /layer_C_0
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Layer G 1
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.1
      Color Transformer: Intensity
      Channel Name: intensity
      Min Intensity: -20
      Max Intensity: 60
      Invert Rainbow: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /layer_G_1
      Use Fixed Frame: true
      Value: false
    - Alpha: 0.5
      Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Layer C 1
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.1
      Color Transformer: FlatColor
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /layer_C_1
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Layer G 2
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.1
      Color Transformer: Intensity
      Channel Name: intensity
      Min Intensity: -20
      Max Intensity: 60
      Invert Rainbow: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /layer_G_2
      Use Fixed Frame: true
      Value: false
    - Alpha: 0.5
      Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Layer C 2
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.1
      Color Transformer: FlatColor
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /layer_C_2
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Enabled: false
